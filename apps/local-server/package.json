{
  "name": "nexura-local-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Nexura local server — runs on each branch's LAN, owns auth and data for that branch. See src/imports/Nexura_Auth_and_Distribution_Architecture.md.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "lint:invariants": "node scripts/lint-invariants.mjs --strict",
    "lint:invariants:strict": "node scripts/lint-invariants.mjs --strict",
    "lint:invariants:update-baseline": "node scripts/lint-invariants.mjs --update-baseline",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "openapi:lint": "redocly lint openapi.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@redocly/cli": "^2.40.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
